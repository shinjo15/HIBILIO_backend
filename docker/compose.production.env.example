APP_IMAGE=<registry>/<app-repository>:<commit-sha>
NGINX_IMAGE=<registry>/<nginx-repository>:<same-commit-sha>
APP_ENV_FILE=/etc/hibilio/production.env
AWS_ENV_FILE=/etc/hibilio/aws.env
REDIS_ENV_FILE=/etc/hibilio/redis.env
POSTGRES_CA_FILE=/etc/hibilio/postgres-ca.crt
ORIGIN_CERT_FILE=/etc/hibilio/tls/origin.crt
ORIGIN_KEY_FILE=/etc/hibilio/tls/origin.key
